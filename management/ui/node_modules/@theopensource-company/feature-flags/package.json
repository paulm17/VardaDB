{
  "module": "./esm/mod.js",
  "main": "./script/mod.js",
  "types": "./types/mod.d.ts",
  "name": "@theopensource-company/feature-flags",
  "version": "0.4.6",
  "description": "Abstraction of logic to handle feature flags",
  "license": "Apache Licence 2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theopensource-company/feature-flags"
  },
  "bugs": {
    "url": "https://github.com/theopensource-company/feature-flags/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./types/mod.d.ts",
        "default": "./esm/mod.js"
      },
      "require": {
        "types": "./types/mod.d.ts",
        "default": "./script/mod.js"
      }
    },
    "./react": {
      "import": {
        "types": "./types/react.d.ts",
        "default": "./esm/react.js"
      },
      "require": {
        "types": "./types/react.d.ts",
        "default": "./script/react.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./types/vue.d.ts",
        "default": "./esm/vue.js"
      },
      "require": {
        "types": "./types/vue.d.ts",
        "default": "./script/vue.js"
      }
    }
  },
  "scripts": {
    "test": "node test_runner.js"
  },
  "dependencies": {
    "@types/react": "*",
    "react": "*",
    "vue": "*"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "chalk": "^4.1.2",
    "@deno/shim-deno": "~0.14.0"
  }
}