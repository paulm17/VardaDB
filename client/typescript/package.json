{
    "name": "varda-client",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "generate": "npx get-graphql-schema http://127.0.0.1:8000/graphql > schema.graphql && npx genql --schema ./schema.graphql --output ./src/genql"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "dependencies": {
        "@genql/runtime": "^2.10.0",
        "@urql/exchange-graphcache": "^7.0.0",
        "graphql": "^16.8.0",
        "graphql-ws": "^5.14.0",
        "urql": "^4.0.0"
    },
    "devDependencies": {
        "@genql/cli": "^6.0.0",
        "@types/node": "^20.0.0",
        "@types/react": "^19.2.10",
        "get-graphql-schema": "^2.1.2",
        "typescript": "^5.0.0"
    }
}
